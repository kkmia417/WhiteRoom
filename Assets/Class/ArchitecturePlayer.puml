@startuml
skinparam classAttributeIconSize 0

interface IPlayerInput {
  + GetMoveDirection() : Vector3
  + GetCameraInput() : Vector2
  + IsDodgePressed() : bool
}

class UnityInputAdapter
UnityInputAdapter ..|> IPlayerInput

class PlayerController
class PlayerStats {
  + MoveSpeed : float
  + DodgeSpeed : float
  + StaminaCurrent : float
  + StaminaMax : float
}

class PlayerStateMachine
interface IPlayerState {
  + Enter()
  + Execute()
  + Exit()
}
class IdleState
class MoveState
class DodgeState
class StaggerState

PlayerController --> IPlayerInput
PlayerController --> PlayerStats
PlayerController --> PlayerStateMachine
PlayerStateMachine --> IPlayerState
IdleState ..|> IPlayerState
MoveState ..|> IPlayerState
DodgeState ..|> IPlayerState
StaggerState ..|> IPlayerState

interface IPlayerTarget
PlayerController ..|> IPlayerTarget

class CameraController
CameraController --> IPlayerTarget

@enduml