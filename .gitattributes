# Keep the repository index and every supported developer checkout deterministic.
* text=auto eol=lf

# Windows command files require CRLF when executed by cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf

# Source files benefit from language-aware diffs.
*.cs text eol=lf diff=csharp

# Unity serializes these files as text (ProjectSettings uses Force Text).
*.anim text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.asset text eol=lf
*.controller text eol=lf
*.cubemap text eol=lf
*.guiskin text eol=lf
*.inputactions text eol=lf
*.lighting text eol=lf
*.mask text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.playable text eol=lf
*.prefab text eol=lf
*.renderTexture text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.terrainlayer text eol=lf
*.unity text eol=lf

# Binary assets must never be line-ending converted or text-merged.
*.7z binary
