root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,shader,hlsl,cginc,compute}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,asmdef,asmref,inputactions}]
indent_style = space
indent_size = 2

[*.{unity,prefab,asset,meta,mat,anim,controller}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
